---
import { Icon } from "astro-icon/components";
import type { BookingTarget } from "../lib/booking";

// 頁面內的主要預約區塊。id 給 StickyBookingBar 用來判斷是否已經看到預約入口。
type Props = BookingTarget;

const { href, title, desc } = Astro.props;
---

{/* 雙層卡殼：外托盤 + 內核，同心圓角 */}
<section id="booking-cta" class="shell reveal mt-24 md:mt-32">
  <div class="core px-5 py-16 text-center md:px-10 md:py-20">
    <div>
      <span class="eyebrow">Reservation</span>
      <h2 class="mt-6 text-amber-100">{title}</h2>
      <p class="mx-auto mt-5 max-w-xl text-cream/70">{desc}</p>
      <a class="btn btn-cta mt-10" href={href} target="_blank" rel="noopener">
        <span class="btn-label">立即預約</span>
        <span class="btn-icon"><Icon name="mdi:calendar-check" class="text-lg" /></span>
      </a>
    </div>
  </div>
</section>
