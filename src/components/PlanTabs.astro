---
import { plans } from "../data/plans";

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const currentPlan = plans.find((p) => `/plans/${p.slug}` === currentPath);

// 依 type 分組，組別與組內順序都沿用 plans.ts 的排列
const groups = plans.reduce<{ type: string; items: typeof plans }[]>((acc, plan) => {
  const group = acc.find((g) => g.type === plan.type);
  if (group) group.items.push(plan);
  else acc.push({ type: plan.type, items: [plan] });
  return acc;
}, []);

// 第二層只顯示當前方案所屬的類別
const activeGroup = groups.find((g) => g.type === currentPlan?.type) ?? groups[0];
---

<nav class="px-4 pt-6">
  <div>
    {/* 第一層：方案類別，點了跳到該類別的第一個款式 */}
    <ul class="flex flex-wrap items-center justify-center gap-1">
      {
        groups.map((group) => (
          <li>
            <a
              href={`/plans/${group.items[0].slug}`}
              class:list={["tab-type", group === activeGroup && "is-active"]}>
              {group.type}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mx-auto my-4 h-px max-w-md bg-gradient-to-r from-transparent via-hairline to-transparent"></div>

    {/* 第二層：該類別底下的款式 */}
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
      {
        activeGroup.items.map((plan) => (
          <li>
            <a
              href={`/plans/${plan.slug}`}
              class:list={["tab-item", plan.slug === currentPlan?.slug && "is-active"]}>
              {plan.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .tab-type {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    font-family: var(--font-eyebrow);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    white-space: nowrap;
    color: rgb(247 242 228 / 0.5);
    transition:
      background-color 0.6s var(--ease-editorial),
      color 0.6s var(--ease-editorial);
  }
  .tab-type:hover { color: var(--color-cream); opacity: 1; }
  .tab-type.is-active {
    background: rgb(247 242 228 / 0.08);
    color: var(--color-primary-light);
    opacity: 1;
  }

  .tab-item {
    position: relative;
    display: inline-block;
    padding-bottom: 0.35rem;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    white-space: nowrap;
    color: rgb(247 242 228 / 0.75);
    transition: color 0.6s var(--ease-editorial);
  }
  .tab-item::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.6s var(--ease-editorial);
  }
  .tab-item:hover { color: var(--color-cream); opacity: 1; }
  .tab-item:hover::after { transform: scaleX(1); }
  .tab-item.is-active { color: var(--color-primary-light); opacity: 1; }
  .tab-item.is-active::after { transform: scaleX(1); }
</style>
