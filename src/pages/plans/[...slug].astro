---
import Layout from "../../layouts/Layout.astro";
import PlanTabs from "../../components/PlanTabs.astro";
import PhotoGallery from "../../components/PhotoGallery.astro";
import BookingCta from "../../components/BookingCta.astro";
import StickyBookingBar from "../../components/StickyBookingBar.astro";
import { kimonoBooking } from "../../lib/booking";
import { plans } from "../../data/plans";

export function getStaticPaths() {
  return plans.map((plan) => ({
    params: { slug: plan.slug },
    props: { plan },
  }));
}

const { plan } = Astro.props;
---

<Layout title={`和服方案│${plan.title}`} eyebrow="Kimono">
  <PlanTabs slot="subheader" />
  <div class="numeral mb-8 text-xs uppercase tracking-[0.2em] text-cream/50" slot="subtitle">
    方案 {plan.type}
  </div>

  <main class="section-tight">
    <div class="site-container">
      <section class="reveal">
        <span class="eyebrow">Sizing</span>
        <h2 class="mt-6 mb-8">尺寸</h2>
        <div class="shell">
          <div class="core px-6 py-7 md:px-8">
            <div class="mb-0 whitespace-pre-line text-cream/80">{plan.intro}</div>
          </div>
        </div>
      </section>

      <section class="mt-20">
        <div class="reveal">
          <span class="eyebrow">Gallery</span>
          <h2 class="mt-6 mb-10">照片集</h2>
        </div>
        <div class="reveal">
          <PhotoGallery dir={`plans/${plan.imageDir}`} alt={plan.title} objectfit="cover" />
        </div>
      </section>

      <BookingCta {...kimonoBooking} />
    </div>
    <StickyBookingBar href={kimonoBooking.href} />
  </main>
</Layout>
