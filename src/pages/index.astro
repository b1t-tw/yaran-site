---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import EntryPersonnel from "../components/EntryPersonnel.astro";
import BookingNotice from "../components/BookingNotice.astro";
import BookingCta from "../components/BookingCta.astro";
import { studioBooking } from "../lib/booking";
import { Icon } from "astro-icon/components";
import logoH from "../assets/logo_h_gold.png";
import logoV from "../assets/logo_v_gold.png";
import yaran_map from "../assets/yaran_map_tp.png";
import hero1 from "../assets/images/20260515_野蘭空間照_CXL_2164.jpg";
import hero2 from "../assets/images/20260515_野蘭空間照_CXL_2170.jpg";
import hero3 from "../assets/images/20260515_野蘭空間照_CXL_2222.jpg";
import hero4 from "../assets/images/20260515_野蘭空間照_CXL_2301.jpg";
import hero5 from "../assets/images/20260515_野蘭空間照_CXL_2327.jpg";

const heroImages = [hero1, hero2, hero3, hero4, hero5];

const transport = [
  { icon: "ic:baseline-train", text: "捷運後山埤站 4 號出口", meta: "步行約 6 分鐘" },
  { icon: "ic:baseline-train", text: "松山火車站", meta: "步行約 10 分鐘" },
  { icon: "ic:baseline-directions-bus", text: "聯合醫院忠孝院區站", meta: "步行約 1 分鐘" },
  {
    icon: "ic:baseline-directions-car",
    text: "168 Parking（昆陽一場）",
    meta: "步行約 3 分鐘",
    href: "https://maps.app.goo.gl/gH8bDAB13MsLYKyk7",
  },
  {
    icon: "ic:baseline-directions-car",
    text: "俥亭天主堂地下停車場",
    meta: "步行約 3 分鐘",
    href: "https://maps.app.goo.gl/TN6gbewNJ69aQMSA6",
  },
];

const rates = [
  { label: "Weekend", title: "假日", was: "2200", now: "1800", unit: "元／小時", note: "試營運優惠" },
  { label: "Weekday", title: "平日", now: "1200", unit: "元／小時（3 小時起）", note: "未滿 3 小時 1500 元／小時" },
  { label: "Add-on", title: "加購整裝", now: "300", unit: "元／小時起", note: "平日 300 元／小時、假日 400 元／小時" },
];

const steps = [
  { title: "確認預約時段", desc: "仔細閱讀攝影棚使用規範後，網站填表預約。", href: studioBooking.href, linkText: "網站填表預約" },
  { title: "支付訂金", desc: "一日內完成付款，逾時視同取消。", href: "/prepaid", linkText: "線上金流" },
  { title: "私訊 FB／IG", desc: "提供「預約人姓名」、「預約時間」、「電話」。" },
  { title: "確認預約", desc: "小幫手會將官網日曆更新。" },
  { title: "當天入場繳餘款", desc: "可用現金或金流付款。" },
];
---

<Layout title="首頁">
  <div id="hero" class="relative flex min-h-[100dvh] w-full items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <div class="swiper hero-swiper">
        <div class="swiper-wrapper">
          {
            heroImages.map((img) => (
              <div class="swiper-slide">
                <Image
                  src={img}
                  alt="Yaran 野蘭攝影棚空間照"
                  format="webp"
                  quality={80}
                  width={2560}
                  class="h-full w-full object-cover object-top"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <div class="absolute inset-0 z-1 bg-primary-dark/65"></div>

    {/* 手機留出底部空間給 scroll 提示，直式 logo 改用高度上限收斂，短螢幕才不會頂到 */}
    <div class="relative z-10 flex w-full flex-col items-center px-6 max-md:pb-28">
      <div id="logo" class="fade-up w-1/2 max-md:w-auto drop-shadow-[0_20px_50px_rgba(0,0,0,0.6)]">
        <Image src={logoH} alt="Yaran 野蘭攝影棚" format="webp" quality={85} class="w-full max-md:hidden" />
        <Image
          src={logoV}
          alt="Yaran 野蘭攝影棚"
          format="webp"
          quality={85}
          class="mx-auto h-[48svh] w-auto max-w-[66vw] object-contain md:hidden"
        />
      </div>
      <p id="hero-tagline" class="hero-tagline mt-8 mb-0 text-center text-cream/70 md:mt-10">
        大正摩登 · 和洋交織的攝影空間
      </p>
    </div>

    <div id="scroll-icon" class="scroll-down-icon absolute bottom-10 left-1/2 z-10 -translate-x-1/2">
      <div class="flex flex-col items-center gap-2">
        <span class="numeral text-[10px] uppercase tracking-[0.28em] text-cream/50">Scroll</span>
        <span class="scroll-line" aria-hidden="true"></span>
      </div>
    </div>
    <div class="absolute inset-x-0 bottom-0 z-2 h-32 bg-gradient-to-t from-primary to-transparent"></div>
  </div>

  <Header />

  <main class="relative w-full">
    {/* ── 交通方式：Editorial Split，左字右圖 ── */}
    <section class="section-tight">
      <div class="site-container grid gap-12 md:grid-cols-[1fr_1.1fr] md:items-center md:gap-16">
        <div class="reveal">
          <span class="eyebrow">Access</span>
          <h2 class="mt-6 mb-8">交通方式</h2>
          <ul class="list-none space-y-0 pl-0">
            {
              transport.map((item) => (
                <li class="flex items-baseline gap-4 border-b border-hairline py-3.5 last:border-0">
                  <Icon name={item.icon} class="translate-y-1 flex-none text-primary-light/70" />
                  <span class="flex-1">
                    {item.href ? (
                      <a href={item.href} target="_blank">
                        {item.text}
                      </a>
                    ) : (
                      item.text
                    )}
                  </span>
                  <span class="numeral flex-none text-xs tracking-widest text-cream/45">{item.meta}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="shell reveal" style="--reveal-delay:120ms">
          <a
            href="https://maps.app.goo.gl/DmGdx7EixuXFXsAH9"
            target="_blank"
            title="查看 Google Map"
            class="core-media no-rule block">
            <Image src={yaran_map} alt="Yaran 野蘭攝影棚交通地圖" format="webp" quality={85} class="w-full" />
          </a>
        </div>
      </div>
    </section>

    {/* ── 租棚方式 ── */}
    <section class="section-tight">
      <div class="site-container">
        <div class="reveal max-w-3xl mx-auto">
          <span class="eyebrow">Booking</span>
          <h2 class="mt-6 mb-8">馬上預約</h2>
          <ul class="list-editorial text-cream/80">
            <li>攝影棚為全預約制，若無預約請勿前往。</li>
            <li>開放時間為 9am - 10pm，休息日於時間表上公告，非開放時間無法回覆訊息請見諒。</li>
            <li>全區 30 坪無隔間，每次僅接待一組客人，不接受中途換人。</li>
            <li>每次租棚以 2 小時起跳。</li>
          </ul>
        </div>

        {/* 價目：三張雙層卡殼並排 */}
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {
            rates.map((rate, i) => (
              <div class="shell reveal" style={`--reveal-delay:${i * 100}ms`}>
                <div class="core flex h-full flex-col px-5 py-7">
                  <span class="numeral text-[10px] uppercase tracking-[0.24em] text-primary-light/60">
                    {rate.label}
                  </span>
                  <h3 class="mt-3 mb-5 text-amber-100">{rate.title}</h3>
                  <div class="mt-auto flex items-baseline gap-2">
                    {rate.was && <del class="text-lg text-cream/35">{rate.was}</del>}
                    <span class="text-5xl font-light tracking-tight text-primary-light">{rate.now}</span>
                    <span class="text-sm text-cream/60">{rate.unit}</span>
                  </div>
                  {rate.note && <p class="mt-3 mb-0 text-sm text-cream/55">{rate.note}</p>}
                </div>
              </div>
            ))
          }
        </div>

        <div class="reveal mt-8 space-y-1 text-sm text-cream/45 max-w-3xl mx-auto">
          <p>系統計算僅供參考，若為國定假日，依假日價格計算。</p>
          <p>加購整裝僅可使用梳化間，進入棚景拍攝即開始計算租棚時間。</p>
          <p>
            以上費用僅適用於「一般人像／Cosplay、Lolita 攝影」，「商業攝影／婚攝／動態攝影／活動合作」的價格請私訊詢問。
          </p>
          <p class="mb-0">商業攝影的定義為用於宣傳、廣告、行銷目的之拍攝。</p>
        </div>

        {/* 預約流程：編號式編輯清單 */}
        <div class="mx-auto mt-24 max-w-3xl">
          <div class="reveal">
            <span class="eyebrow">How it works</span>
            <h2 class="mt-6 mb-12">預約方式</h2>
          </div>
          <ol class="list-none space-y-0 pl-0">
            {
              steps.map((step, i) => (
                <li
                  class="reveal grid grid-cols-[3rem_1fr] items-start gap-x-4 gap-y-1 border-t border-hairline py-6 last:border-b md:grid-cols-[5rem_1fr] md:gap-x-8"
                  style={`--reveal-delay:${i * 80}ms`}>
                  <span class="numeral pt-1 text-xs tracking-[0.2em] text-primary-light/50">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h4 class="mb-1 text-amber-100">{step.title}</h4>
                    <p class="mb-0 text-cream/70">
                      {step.desc}
                      {step.href && (
                        <>
                          {" "}
                          <a href={step.href} target="_blank">
                            {step.linkText}
                          </a>
                        </>
                      )}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="reveal mt-24 grid gap-x-16 md:grid-cols-2">
          <div><EntryPersonnel /></div>
          <div>
            <BookingNotice>
              <li>更多注意事項請見<a href="/rules">租棚須知</a>。</li>
            </BookingNotice>
          </div>
        </div>

        {/* 返圖回饋 */}
        <div class="shell reveal mt-16">
          <div class="core flex flex-col gap-6 px-5 py-8 md:flex-row md:items-center md:justify-between md:px-10">
            <div>
              <span class="eyebrow">Give back</span>
              <p class="mt-4 mb-1 text-xl text-amber-100">拍攝後一個月內返圖 5 張，即可退款 400 元</p>
              <p class="mb-0 text-sm text-cream/45">※ 感謝「可以澀澀攝影棚」提供表單模板</p>
            </div>
            <a
              href="https://forms.gle/ru7zbkvQNvYzJe8M9"
              target="_blank"
              class="btn btn-ghost flex-none self-start md:self-auto">
              <span class="btn-label">返圖表單</span>
              <span class="btn-icon"><Icon name="ic:round-open-in-new" class="text-base" /></span>
            </a>
          </div>
        </div>

        <BookingCta {...studioBooking} />
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero-swiper,
  .hero-swiper .swiper-wrapper,
  .hero-swiper .swiper-slide {
    width: 100%;
    height: 100%;
  }

  .fade-up,
  .hero-tagline {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 1.4s var(--ease-editorial),
      transform 1.4s var(--ease-editorial);
  }
  .fade-up.animate,
  .hero-tagline.animate {
    opacity: 1;
    transform: none;
  }
  .hero-tagline {
    font-size: 0.9rem;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    transition-delay: 500ms;
  }

  .scroll-down-icon {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.9s var(--ease-editorial),
      transform 0.9s var(--ease-editorial);
  }
  .scroll-down-icon.show {
    opacity: 1;
    transform: none;
  }

  /* 一條會反覆向下流動的細線，取代彈跳箭頭 */
  .scroll-line {
    display: block;
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(to bottom, rgb(247 242 228 / 0.5), transparent);
    transform-origin: top;
    animation: scroll-flow 2.6s var(--ease-editorial) infinite;
  }
  @keyframes scroll-flow {
    0% { transform: scaleY(0); opacity: 0; }
    35% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1) translateY(3.5rem); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-up,
    .hero-tagline,
    .scroll-down-icon {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .scroll-line { animation: none; }
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay, EffectFade } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/effect-fade";

  document.addEventListener("astro:page-load", () => {
    const heroEl = document.querySelector<HTMLElement>(".hero-swiper");
    if (!heroEl) return;

    const hero = new Swiper(heroEl, {
      modules: [Autoplay, EffectFade],
      effect: "fade",
      fadeEffect: { crossFade: true },
      loop: true,
      speed: 4000,
      allowTouchMove: false,
      autoplay: {
        delay: 100,
        disableOnInteraction: false,
      },
    });

    // 換頁後 autoplay 的計時器還會跑在被換掉的 DOM 上，要收掉
    document.addEventListener("astro:before-swap", () => hero.destroy(), { once: true });

    const logo = document.getElementById("logo");
    const tagline = document.getElementById("hero-tagline");
    const scrollIcon = document.getElementById("scroll-icon");

    if (logo && tagline && scrollIcon) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            logo.classList.add("animate");
            tagline.classList.add("animate");
            setTimeout(() => scrollIcon.classList.add("show"), 1600);
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
      );
      observer.observe(logo);
    }
  });
</script>
