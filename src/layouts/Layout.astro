---
import '../styles/main.css';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import { kimonoBooking } from '../lib/booking';
import Header from '../components/Header.astro';
import hero1 from '../assets/images/20260515_野蘭空間照_CXL_2164.jpg';

interface Props {
  title: string;
  /* 標題上方的微型膠囊標，不給就用站名 */
  eyebrow?: string;
  /* 不讓搜尋引擎收錄（仍會跟隨連結）；同時要在 astro.config 的 sitemap filter 排除 */
  noindex?: boolean;
  /* Meta Pixel ViewContent 參數；有給才送（目前只有方案頁，content_ids 需對應商品目錄 g:id） */
  viewContent?: Record<string, unknown>;
}

const { title, eyebrow = "Yaran Studio", noindex = false, viewContent } = Astro.props;
const fullTitle = `${title} - YARAN 野蘭攝影棚`;
const description = 'YARAN 野蘭攝影棚';

// 分享預覽圖：原圖 2560px 太重，縮成 1200px 寬；og:image 需要絕對網址
const ogImage = await getImage({ src: hero1, format: 'jpeg', quality: 80, width: 1200 });
const ogImageUrl = new URL(ogImage.src, Astro.site);

// 背景圖樣清單（放在 public/patterns/），每次載入隨機挑一張
const patterns = Object.keys(import.meta.glob('/public/patterns/*.png')).map(
  (path) => path.replace('/public', '')
);
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo_icon.png" />
    <script is:inline define:vars={{ patterns }}>
      // 每次載入隨機選一張背景圖樣，設定給 body::before 使用
      // 換頁時排除上一張，確保一定會換成不同的圖樣
      // head 的 inline script 只跑一次，SPA 換頁要靠 astro:after-swap 再挑一次
      function pickPattern() {
        if (!patterns.length) return;
        const last = sessionStorage.getItem('background-pattern');
        const candidates = patterns.filter((p) => p !== last);
        const pool = candidates.length ? candidates : patterns;
        const pick = pool[Math.floor(Math.random() * pool.length)];
        sessionStorage.setItem('background-pattern', pick);
        document.documentElement.style.setProperty(
          '--background-pattern',
          `url("${pick}")`
        );
      }
      pickPattern();
      document.addEventListener('astro:after-swap', pickPattern);
    </script>
    <title>{fullTitle}</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={ogImage.options.width} />
    <meta property="og:image:height" content={ogImage.options.height} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chiron+Sung+HK:ital,wght@0,200..900;1,200..900&family=Cinzel:wght@400..700&family=Cormorant+Infant:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Q3919S3X7X"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Q3919S3X7X');
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5CPDV3HJ');
    </script>
    <!-- End Google Tag Manager -->
    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      // SPA 換頁的 PageView 由下方 astro:after-swap 手動送；關掉 Pixel 依 history.pushState 自動送的 PageView，避免重複
      fbq.disablePushState = true;
      fbq('init', '2839746599700251');
      fbq('track', 'PageView');
    </script>
    <!-- Track booking CTA clicks as InitiateCheckout: frametime.app（租棚）與和服預約表單 -->
    <script define:vars={{ kimonoBookingHref: kimonoBooking.href }}>
      // 站內 SPA 換頁後網址的 UTM 會消失：首次進站時存進 sessionStorage，外連 handoff 時再取用
      var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign'];
      function readUtm(params) {
        var utm = {};
        UTM_KEYS.forEach(function (key) {
          var value = params.get(key);
          if (value) utm[key] = value;
        });
        return Object.keys(utm).length ? utm : null;
      }
      try {
        var landingUtm = readUtm(new URLSearchParams(window.location.search));
        if (landingUtm) sessionStorage.setItem('yaran_landing_utm', JSON.stringify(landingUtm));
      } catch (err) {}

      // 和服預約表單：方案頁帶與 ViewContent 相同的商品參數（#fb-view-content），總覽頁沒有單一商品就不帶
      function trackKimonoCheckout() {
        var params;
        try {
          var el = document.getElementById('fb-view-content');
          if (el) params = JSON.parse(el.textContent);
        } catch (err) {}
        if (window.fbq) fbq('track', 'InitiateCheckout', params);
      }

      document.addEventListener('click', function (e) {
        var a = e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href');
        if (href === kimonoBookingHref) return trackKimonoCheckout();
        if (href.indexOf('frametime.app') === -1) return;

        // Original ad attribution: current page URL first, else the UTM saved on landing
        var utm = readUtm(new URLSearchParams(window.location.search));
        if (!utm) {
          try { utm = JSON.parse(sessionStorage.getItem('yaran_landing_utm')); } catch (err) {}
        }
        utm = utm || {};
        var src = utm.utm_source;
        var medium = utm.utm_medium;
        var campaign = utm.utm_campaign;

        // Frametime is our referrer: identify our site as the source, keep the
        // campaign, and preserve the original ad attribution under namespaced keys.
        var handoff = {
          utm_source: 'yaran-site',
          utm_medium: 'referral',
        };
        if (campaign) handoff.utm_campaign = campaign;
        if (src) handoff.yaran_src = src;
        if (medium) handoff.yaran_medium = medium;

        // Append to the frametime destination URL (without overwriting existing params)
        try {
          var dest = new URL(a.href, window.location.origin);
          Object.keys(handoff).forEach(function (key) {
            if (!dest.searchParams.has(key)) dest.searchParams.set(key, handoff[key]);
          });
          a.href = dest.toString();
        } catch (err) {}

        if (window.fbq) fbq('track', 'InitiateCheckout', handoff);
      });
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=2839746599700251&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
    <!-- SPA 換頁後補送瀏覽事件：gtag config / fbq PageView 只在首次載入時送 -->
    <script is:inline>
      document.addEventListener('astro:after-swap', function () {
        if (window.gtag) {
          gtag('event', 'page_view', {
            page_location: window.location.href,
            page_title: document.title,
          });
        }
        if (window.fbq) fbq('track', 'PageView');
      });
      // ViewContent：astro:page-load 首次載入與每次 SPA 換頁都會觸發，參數由頁面放在 #fb-view-content
      document.addEventListener('astro:page-load', function () {
        var el = document.getElementById('fb-view-content');
        if (el && window.fbq) fbq('track', 'ViewContent', JSON.parse(el.textContent));
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5CPDV3HJ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {viewContent && (
      <script
        is:inline
        type="application/json"
        id="fb-view-content"
        set:html={JSON.stringify(viewContent).replace(/</g, '\\u003c')}
      />
    )}
    {
      title !== '首頁' && (
        <>
          <Header />
          <slot name="subheader" />
          <div class="text-center">
            <div class="site-container pt-14 pb-2 md:pt-20">
              <span class="eyebrow reveal">{eyebrow}</span>
              <h1 class="mt-7 reveal" style="--reveal-delay:100ms">
                {title}
              </h1>
            </div>
            <div class="reveal mt-7 text-primary-light" style="--reveal-delay:200ms">
              <slot name="subtitle" />
            </div>
            <div class="mx-auto h-px max-w-5xl bg-gradient-to-r from-transparent via-hairline-strong to-transparent" />
          </div>
        </>
      )
    }
    <slot />
    <Footer />
    <script is:inline>
      // 全站捲動進場：只用 IntersectionObserver，不掛 scroll 事件
      // astro:page-load 首次載入與每次 SPA 換頁都會觸發
      document.addEventListener('astro:page-load', function () {
        var els = document.querySelectorAll('.reveal');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach(function (el) { io.observe(el); });
      });
    </script>
  </body>
</html>
